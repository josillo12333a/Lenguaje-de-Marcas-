<html>
<html lang="es">
<head>
    <title>Gym Asir</title>
</head>
<body>
 <h2 style="text-align: center;">José Domingo de Luis Perdomo</h2>
    <main>
        <div style="text-align: center;">
            <img src="futbol.avif" alt="Logo del Club Deportivo" width="150">
        </div>
        <h2>Formulario de Inscripción a un club deportivo</h2>
        <form action="recorrer.php" method="POST" enctype="multipart/form-data">
            <fieldset>
                <legend>Datos Personales</legend>
                <p>
                    <label for="dni">DNI: *</label>
                    <input type="text" id="dni" name="alumdni" maxlength="9" pattern="[0-9]{8}[A-Za-z]{1}" title="8 números seguidos de 1 letra" required>
                </p>
                <p>
                    <label for="nombre">Nombre: *</label>
                    <input type="text" id="nombre" name="alumnombre" maxlength="20" required>
                </p>
                <p>
                    <label for="apellido1">Apellido 1: *</label>
                    <input type="text" id="apellido1" name="alumapellido1" maxlength="20" required>
                </p>
                <p>
                    <label for="apellido2">Apellido 2:</label>
                    <input type="text" id="apellido2" name="alumapellido2" maxlength="20">
                </p>
                <p>
                    <label for="direccion">Dirección:</label>
                    <input type="text" id="direccion" name="alumdireccion" maxlength="80">
                </p>
                <p>
                    <label for="cp">Código Postal:</label>
                    <input type="text" id="cp" name="alumcp" maxlength="5" pattern="[0-9]{5}" title="5 dígitos numéricos">
                </p>
                <p>
                    <label for="poblacion">Población:</label>
                    <input type="text" id="poblacion" name="alumpoblacion" maxlength="64">
                </p>
                <p>
                    <label for="provincia">Provincia:</label>
                    <select id="provincia" name="alumprovincia">
                        <option value="Santa Cruz de Tenerife" selected>Santa Cruz de Tenerife</option>
                        <option value="Las Palmas">Las Palmas</option>
                        <option value="Madrid">Madrid</option>
                        <option value="Valencia">Valencia</option>
                    </select>
                </p>
                <p>
                    <label for="telefono">Teléfono:</label>
                    <input type="tel" id="telefono" name="alumtelefono" maxlength="9" pattern="[0-9]{9}" title="9 dígitos numéricos">
                </p>
                <p>
                    <label for="email">Email:</label>
                    <input type="email" id="email" name="alumemail" maxlength="64">
                </p>
                <p>
                    <label for="usuario">Usuario:</label>
                    <input type="text" id="usuario" name="alumusuario" maxlength="9">
                </p>

                <p>
                    <label for="password">Contraseña:</label>
                    <input type="password" id="password" name="alumpassword" maxlength="9">
                <p>
                    <label for="fecha_nac">Fecha de nacimiento:</label>
                    <input type="date" id="fecha_nac" name="alumfechanac">
                </p>
                <p>
                    <label for="sexo">Sexo:</label>
                    <select id="sexo" name="alumsexo">
                        <option value="MUJER">MUJER</option>
                        <option value="HOMBRE">HOMBRE</option>
                        <option value="OTRO">OTRO</option>
                    </select>
                </p>
                <p>
                    <label for="documento">Foto o DNI escaneado (PDF o JPG):</label>
                    <input type="file" id="documento" name="alumdocumento" accept=".pdf, .jpg, .jpeg, application/pdf, image/jpeg">
                </p>
            </fieldset>
            <fieldset>
                <legend>Datos Deportivos</legend>
                <p>
                    <label for="deporte">Deporte favorito:</label>
                    <select id="deporte" name="alumdeporte">
                        <option value="FÚTBOL">FÚTBOL</option>
                        <option value="TENIS">TENIS</option>
                        <option value="NATACIÓN">NATACIÓN</option>
                        <option value="CICLISMO">CICLISMO</option>
                    </select>
                </p>
                <p>
                    Experiencia previa en clubes:
                    <input type="radio" id="exp_si" name="alumexperiencia" value="Sí">
                    <label for="exp_si">Sí</label>
                    <input type="radio" id="exp_no" name="alumexperiencia" value="No">
                    <label for="exp_no">No</label>
                </p>
                <p>
                    <label for="club_anterior">Nombre del club anterior:</label>
                    <input type="text" id="club_anterior" name="alumclubanterior" maxlength="32">
                </p> 
                <p>
                    <label for="categoria">Categoría solicitada:</label>
                    <select id="categoria" name="alumcategoria">
                        <option value="INFANTIL">INFANTIL</option>
                        <option value="JUVENIL">JUVENIL</option>
                        <option value="SENIOR">SENIOR</option>
                    </select>
                </p>
                </fieldset>
                <fieldset>
                    <legend>Idiomas y datos adicionales</legend>
                <p>
                    <label for="idiomas">Idiomas:</label><br>
                    <select id="idiomas" name="alumidiomas[]" multiple size="4">
                        <option value="ESPAÑOL">ESPAÑOL</option>
                        <option value="INGLÉS">INGLÉS</option>
                        <option value="FRANCÉS">FRANCÉS</option>
                        <option value="OTROS">OTROS</option>
                    </select>
                </p>
                <p>
                    <label for="otros_idiomas">Si elegiste OTROS idiomas, especifícalo aquí:</label><br>
                    <textarea id="otros_idiomas" name="alumotrosidiomas" rows="2" cols="40"></textarea>
                </p>
                <p>
                    <label for="otros_datos">Otros datos de interés:</label><br>
                    <textarea id="otros_datos" name="alumotrosdatos" rows="4" cols="40"></textarea>
                </p>
            </fieldset>
            <p>
                <input type="submit" value="Enviar">
                <input type="reset" value="Limpiar formulario">
            </p>
        </form>
    </main>
</body>
</html>

